# Pantry Tracker — Environment Variables

# Supabase: project dashboard → Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Gemini AI — SERVER-SIDE ONLY (no VITE_ prefix; it must never reach the bundle).
# Used by netlify/functions/gemini.mjs, the shared-tier AI proxy.
#   Production: set GEMINI_API_KEY in the Netlify dashboard
#     (Site configuration → Environment variables).
#   Local dev with AI: put it here and run `netlify dev` (which serves the
#     function); plain `vite dev` has no function, so either set
#     VITE_DISABLE_AI_PROXY=true or paste a personal key in Settings → AI.
# Free key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional model overrides. The proxy reads GEMINI_MODEL (falling back to
# VITE_GEMINI_MODEL); in-browser user-key calls read VITE_GEMINI_MODEL only.
# GEMINI_MODEL=gemini-2.5-flash
# VITE_GEMINI_MODEL=gemini-2.5-flash

# Optional: turn off the shared AI tier (e.g. plain `vite dev`). Users can
# still paste a personal key in Settings → AI (stored in their browser only).
# VITE_DISABLE_AI_PROXY=true

# Web-push expiry reminders (netlify/functions/expiry-notifications.mjs).
# Generate the key pair once: npx web-push generate-vapid-keys
# VITE_VAPID_PUBLIC_KEY goes to the client; the private key stays server-side.
# All of these must also be set in the Netlify dashboard for production,
# along with SUPABASE_SERVICE_ROLE_KEY (dashboard → Settings → API).
VITE_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
SUPABASE_SERVICE_ROLE_KEY=

# Local/bootstrap ONLY: allow the AI proxy through when the consume_ai_quota
# RPC is missing (i.e. migrations not applied). Never set this in production —
# it disables the only spend boundary on the shared Gemini key.
# AI_QUOTA_FAIL_OPEN=true
